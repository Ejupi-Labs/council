{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council billing",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "unknown",
        "api",
        "subscription",
        "local"
      ]
    },
    "accountKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "plan": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "reported"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "observedAt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000]+$"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000]+$"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000]+$"
          },
          "limit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "remaining": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "used": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "resetAt": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "required": [
          "id",
          "label",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "prices": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[^\\u0000]+$"
        },
        "inputPerMillion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outputPerMillion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "routing": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "small",
            "standard",
            "large"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "costRank": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "qualityRank": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "tier"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "dont-kill-an-ant-with-a-bazooka",
          "council-implementation-review",
          "council-independent-perspectives",
          "council-advisor"
        ]
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
