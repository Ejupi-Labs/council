  "council_routing_policy_update": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[^0-9]"
            }
          },
          "economyOrder": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "codex-native-default",
                "codex-luna-economy",
                "codex-sol-general",
                "claude-native-default",
                "claude-haiku-economy",
                "claude-sonnet-general"
              ]
            }
          },
          "unknownAvailability": {
            "type": "string",
            "enum": [
              "allow",
              "require_positive"
            ]
          },
          "defaultBudget": {
            "type": "object",
            "properties": {
              "admissionLimit": {
                "type": "string",
                "pattern": "^([1-9]|1[0-6])$"
              },
              "windowSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              }
            },
            "additionalProperties": false
          },
          "continuation": {
            "type": "object",
            "properties": {
              "maxAutomaticAdmissions": {
                "type": "string",
                "pattern": "^(0|[1-9]|1[0-5])$"
              },
              "categories": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "pre_launch_ineligible",
                    "terminal_transient"
                  ]
                }
              },
              "allowReplacement": {
                "type": "boolean"
              },
              "allowEscalation": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "input"
    ]
  },
