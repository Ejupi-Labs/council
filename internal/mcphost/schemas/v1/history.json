{
  "council_history_records": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "snapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "tasks",
          "attempts"
        ]
      },
      "limit": {
        "type": "string",
        "pattern": "^([1-9]|[1-9][0-9]|100)$",
        "not": {
          "pattern": "[^0-9]"
        }
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "required": [
      "snapshotId",
      "kind"
    ],
    "additionalProperties": false
  },
  "council_history_capture": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "projectId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "requestId",
          "projectId"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false
  },
  "council_history_snapshot_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "snapshotId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "required": [
      "snapshotId"
    ],
    "additionalProperties": false
  },
  "council_history_preview": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "snapshotId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "snapshotRevision": {
            "const": "1"
          },
          "filename": {
            "type": "string",
            "pattern": "^history-[A-Za-z0-9][A-Za-z0-9_-]{0,50}\\.json$",
            "not": {
              "pattern": "[^A-Za-z0-9_.-]"
            }
          }
        },
        "required": [
          "requestId",
          "snapshotId",
          "snapshotRevision",
          "filename"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false
  },
  "council_history_export": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "previewId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "previewRevision": {
            "const": "1"
          }
        },
        "required": [
          "requestId",
          "previewId",
          "previewRevision"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "input"
    ],
    "additionalProperties": false
  },
  "council_history_operation_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "required": [
      "operationId"
    ],
    "additionalProperties": false
  },
  "council_history_reconcile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "expectedRevision": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[^0-9]"
            }
          },
          "action": {
            "const": "verify_no_publication"
          }
        },
        "required": [
          "requestId",
          "expectedRevision",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "operationId",
      "input"
    ],
    "additionalProperties": false
  }
}
