  "council_routing_profile_update": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "enum": [
          "codex-native-default",
          "codex-luna-economy",
