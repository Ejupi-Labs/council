{
  "name": "council-ai-plugin",
  "version": "0.1.0",
  "description": "Local collaboration workflows for Codex, Claude Code, DeepSeek Harness, Junie and Antigravity.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0" },
  "bin": { "council": "dist/cli.js" },
  "exports": "./dist/index.js",
  "files": ["dist", "skills", "commands", ".codex-plugin", ".claude-plugin", ".mcp.json", "mcp.json", "plugin.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node dist/cli.js demo",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.1.14",
    "@modelcontextprotocol/sdk": "1.32.2",
    "acpx": "0.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "7.0.2" },
  "overrides": {
    "acpx": { "tsx": "4.23.1", "zod": "$zod" },
    "qs": "6.16.0"
  }
}
