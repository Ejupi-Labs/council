            "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[^0-9]"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "referencePrice": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3,
                "pattern": "^[A-Z]{3}$"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "per_million_tokens"
                ]
              },
              "basis": {
                "type": "string",
                "enum": [
                  "api_list",
                  "declared_marginal"
                ]
              },
              "inputPerMillion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
                "not": {
                  "pattern": "[^0-9eE+.-]"
                }
              },
              "outputPerMillion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
                "not": {
                  "pattern": "[^0-9eE+.-]"
                }
              },
              "sourceLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sourceUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "observedAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "validUntil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "additionalProperties": false,
            "required": [
              "currency",
              "sourceLabel",
              "observedAt"
            ]
          },
          "clearReferencePrice": {
            "const": true
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision"
        ],
        "not": {
          "required": [
            "referencePrice",
            "clearReferencePrice"
          ]
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "input"
    ]
  },
