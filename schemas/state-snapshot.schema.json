{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council state-snapshot",
  "type": "object",
  "properties": {
    "format": {
      "const": "council-state-snapshot"
    },
    "formatVersion": {
      "const": 1
    },
    "councilVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "completedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "consistency": {
      "const": "per-database"
    },
    "artifactsIncluded": {
      "const": false
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "state.db",
              "rooms.sqlite",
              "billing.sqlite",
              "private-chats.sqlite",
              "delegation.sqlite"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "startedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "completedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "bytes",
          "sha256",
          "schemaVersion",
          "startedAt",
          "completedAt"
        ],
        "additionalProperties": false
      }
    },
    "absentDatabases": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "state.db",
          "rooms.sqlite",
          "billing.sqlite",
          "private-chats.sqlite",
          "delegation.sqlite"
        ]
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "councilVersion",
    "startedAt",
    "completedAt",
    "consistency",
    "artifactsIncluded",
    "databases",
    "absentDatabases"
  ],
  "additionalProperties": false
}
