{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council model-map-query",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "lead",
        "worker",
        "reviewer",
        "advisor",
        "economy"
      ]
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "includeFullCatalog": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}
