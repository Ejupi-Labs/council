{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council workflow",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "delegate",
        "review",
        "debate",
        "parallel",
        "pipeline",
        "council"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 1
    },
    "judge": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "permission": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ],
      "default": "read"
    },
    "context": {
      "type": "string",
      "minLength": 0
    },
    "maxCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "agentSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dont-kill-an-ant-with-a-bazooka",
                "council-implementation-review",
                "council-independent-perspectives",
                "council-advisor"
              ]
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "advisors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxRequests": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "required": [
          "agent"
        ],
        "additionalProperties": false
      }
    },
    "privateChats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "peers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 1
          },
          "maxRequests": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "required": [
          "peers"
        ],
        "additionalProperties": false
      }
    },
    "contextLimit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "required": [
    "mode",
    "task",
    "agents"
  ],
  "additionalProperties": false
}
