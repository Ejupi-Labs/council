{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council model-map",
  "type": "object",
  "properties": {
    "asOf": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "retrievedAt": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "benchmark-owner",
              "vendor",
              "methodology"
            ]
          },
          "publishedAt": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "retrievedAt",
          "publisher",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "benchmark": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "score": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "higher",
              "lower"
            ]
          },
          "harness": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "effort": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cohort": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "required": [
          "id",
          "sourceId",
          "modelId",
          "benchmark",
          "version",
          "metric",
          "score",
          "unit",
          "direction",
          "harness",
          "effort",
          "cohort"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "legacy"
            ]
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000]+$"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "lead",
                    "worker",
                    "reviewer",
                    "advisor",
                    "economy"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "benchmark",
                    "vendor-guidance",
                    "policy-inference"
                  ]
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000]+$"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "task",
                "priority",
                "role",
                "basis",
                "confidence",
                "reason",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "effortNotes": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "harnesses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "referencePricing": {
            "type": "object",
            "properties": {
              "inputPerMillion": {
                "type": "number",
                "minimum": 0
              },
              "outputPerMillion": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              }
            },
            "required": [
              "inputPerMillion",
              "outputPerMillion",
              "currency",
              "sourceId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "provider",
          "status",
          "strengths",
          "limitations",
          "evidenceIds",
          "recommendations"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "asOf",
    "revision",
    "sources",
    "observations",
    "models",
    "tasks"
  ],
  "additionalProperties": false
}
