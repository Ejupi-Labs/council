                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "destination": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "acceptanceBasis": {
                        "type": "string",
                        "enum": [
                          "command_completion"
                        ]
                      },
                      "command": {
                        "type": "object",
                        "properties": {
                          "executable": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "arguments": {
                            "type": "array",
                            "maxItems": 64,
                            "items": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          },
                          "timeoutSeconds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1800
                          }
                        },
