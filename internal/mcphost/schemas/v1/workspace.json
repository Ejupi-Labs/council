{
  "council_projects_open": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "selectedPath": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\u0000"
            },
            "description": "A valid nonempty path; the owner validates platform-specific path semantics."
          },
          "basePath": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\u0000"
            },
            "description": "Absolute base path; the owner validates platform-specific absolute-path semantics."
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "selectedPath",
          "basePath"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "input"
    ]
  },
  "council_projects_list": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "limit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3,
        "pattern": "^([1-9]|[1-9][0-9]|100)$",
        "not": {
          "pattern": "[^0-9]"
        }
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^[A-Za-z0-9_-]+$",
        "not": {
          "pattern": "[^A-Za-z0-9_-]"
        },
        "description": "Opaque canonical cursor returned by this list for the same filter; the owner validates its contents."
      }
    },
    "additionalProperties": false
  },
  "council_projects_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "additionalProperties": false,
    "required": [
      "id"
    ]
  },
  "council_policy_set": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "expectedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 19,
            "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[^0-9]"
            },
            "description": "Canonical positive signed 64-bit decimal revision."
          },
          "mode": {
            "type": "string",
            "enum": [
              "autonomous",
              "supervised"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "mode"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "input"
    ]
  },
  "council_drafts_create": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "projectId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "originalText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4194304,
            "description": "Non-whitespace UTF-8 task text, at most 4 MiB in encoded bytes; the owner enforces both constraints."
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "projectId",
          "originalText"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "input"
    ]
  },
  "council_drafts_list": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "projectId": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "limit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3,
        "pattern": "^([1-9]|[1-9][0-9]|100)$",
        "not": {
          "pattern": "[^0-9]"
        }
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^[A-Za-z0-9_-]+$",
        "not": {
          "pattern": "[^A-Za-z0-9_-]"
        },
        "description": "Opaque canonical cursor returned by this list for the same filter; the owner validates its contents."
      }
    },
    "additionalProperties": false
  },
  "council_drafts_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "revision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 19,
        "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
        "not": {
          "pattern": "[^0-9]"
        },
        "description": "Canonical positive signed 64-bit decimal revision."
      }
    },
    "additionalProperties": false,
    "required": [
      "id"
    ]
  },
  "council_drafts_update": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 32,
        "maxLength": 32,
        "pattern": "^[a-f0-9]{32}$"
      },
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "expectedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 19,
            "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[^0-9]"
            },
            "description": "Canonical positive signed 64-bit decimal revision."
          },
          "originalText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4194304,
            "description": "Non-whitespace UTF-8 task text, at most 4 MiB in encoded bytes; the owner enforces both constraints."
          },
          "useCurrentPolicy": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "expectedRevision",
          "originalText"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "input"
    ]
  },
  "council_service_stop": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "input": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          },
          "ownerInstanceId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "requestId",
          "ownerInstanceId"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "input"
    ]
  }
}
