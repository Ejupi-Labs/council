{
  "name": "council-ai-plugin",
  "version": "1.1.0",
  "description": "Dependency-free local collaboration for Codex, Claude Code, DeepSeek Harness, Junie and Antigravity.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.1"
  },
  "bin": {
    "council": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "commands",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "mcp.json",
    "plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "schemas",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-schemas.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "demo": "npm run build && node dist/cli.js demo",
    "prepack": "npm run build",
    "test:release": "npm run build && node --test tests/release.test.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "verify": "npm run check && npm test && npm run audit:runtime",
    "release:local": "npm run build && node scripts/release.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "types": "./dist/index.d.ts",
  "overrides": {
    "qs": "6.16.0"
  }
}
