                          "arguments"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "action",
                      "destination",
                      "acceptanceBasis",
                      "command"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "checks": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9_-]+$",
                      "not": {
                        "pattern": "[^a-z0-9_-]"
                      },
                      "allOf": [
                        {
                          "not": {
                            "pattern": "^(task-|required-|workflow-|delivery-|independent-review$|local-integration$|external-delivery$)"
                          }
                        }
                      ]
                    },
                    "executable": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "arguments": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "relativeWorkingDirectory": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "scope": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "whole_candidate",
                            "declared_subset"
                          ]
                        },
                        "paths": {
                          "type": "array",
                          "maxItems": 256,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          }
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "paths"
                      ],
                      "oneOf": [
                        {
                          "properties": {
                            "kind": {
                              "const": "whole_candidate"
                            },
                            "paths": {
                              "maxItems": 0
                            }
                          }
                        },
                        {
                          "properties": {
                            "kind": {
                              "const": "declared_subset"
                            },
                            "paths": {
                              "minItems": 1
                            }
                          }
                        }
                      ]
                    },
                    "coveredConditionKeys": {
                      "type": "array",
